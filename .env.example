# Required. Without it the map area explains what is missing rather than
# failing. Must also be set when running `npm run build` — Next inlines
# NEXT_PUBLIC_* into the client bundle at build time.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional. One-sentence descriptions for clicked places. Read on the server at
# request time; without it the popup shows the name and category alone.
MISTRAL_API_KEY=

# Optional. Reads place descriptions aloud in the popup. Audio is generated
# once per place and cached under data/audio, so a place costs credits once.
ELEVENLABS_API_KEY=
# Optional. Defaults to the first voice on the account.
ELEVENLABS_VOICE_ID=

# Optional. How many reverse proxies sit in front of the app. The rate limiter
# reads the client address that many hops from the right of `x-forwarded-for`,
# so anything a client sent itself is ignored. Defaults to 1, which is right
# for a single proxy (Traefik, nginx, Caddy) that appends the peer address.
# Raise it to 2 when a CDN forwards to that proxy.
TRUSTED_PROXY_HOPS=1

# Optional. Origins allowed to frame the map and push their theme into it, as
# a `frame-ancestors` allowlist and the only senders the frame listens to.
# Read at build time, so the deployed value is the one that was set then.
# Unset means the map refuses to be framed anywhere but this site.
EMBED_PARENTS=http://localhost:3000
